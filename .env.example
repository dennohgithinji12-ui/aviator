# PostgreSQL Database (Neon or Local)
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"
# Use the pooled connection string for app traffic on Vercel (pooled.db.prisma.io).
DATABASE_URL_POOLED="postgresql://user:password@pooled-host/database?sslmode=require"
DIRECT_URL="postgresql://user:password@host/database?sslmode=require"

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
GAME_MASTER_SECRET=generate-a-long-random-game-secret

# Initial admin login (the seed hashes this password before storing it)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-long-password
ADMIN_NAME=ShiftStack Administrator
ADMIN_JWT_SECRET=generate-a-different-random-admin-jwt-secret
CRON_SECRET=generate-a-long-random-scheduler-secret

# PayHero M-PESA STK Push (credentials from PayHero > API Credentials)
# Or use PAYHERO_BASIC_AUTH_TOKEN instead of the username/password pair.
# PAYHERO_BASIC_AUTH_TOKEN=base64_username_colon_password
PAYHERO_API_USERNAME=your_payhero_api_username
PAYHERO_API_PASSWORD=your_payhero_api_password
PAYHERO_CHANNEL_ID=your_registered_mpesa_channel_id
PAYHERO_PAYOUTS_ENABLED=false
PAYHERO_PAYOUT_ACCOUNT_ID=your_payhero_account_id
PAYHERO_NETWORK_CODE=63902
PAYHERO_CALLBACK_SECRET=generate-a-long-random-callback-secret
APP_BASE_URL=https://example.com

# Firebase Configuration
FIREBASE_API_KEY=your_firebase_web_api_key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_APP_ID=your-firebase-app-id
FIREBASE_MESSAGING_SENDER_ID=your-firebase-messaging-sender-id
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@shiftstack-aviator.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_SPARK_MODE=true

# Game Constants
MINIMUM_DEPOSIT_KES=49
MINIMUM_STAKE_KES=100
MAX_WEEKLY_PASSWORD_RESETS=2
