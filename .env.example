# ==============================================================================
# ShiftStack Aviator Security & Environment Configuration
# ==============================================================================
# SECURITY REMINDER:
# API keys give full access to your account via the API.
# NEVER share them publicly, commit them to git, or embed them in client-side code.
# Store sensitive secrets ONLY in this server-side .env file or server process environment.
# ==============================================================================

# Server Network Port
PORT=3000

# ------------------------------------------------------------------------------
# 1. PayHero API Credentials (Kenyan M-PESA STK Push)
# Obtain from your PayHero merchant dashboard: https://backend.payhero.co.ke
# When left empty, the server automatically runs in simulated Sandbox mode.
# ------------------------------------------------------------------------------
PAYHERO_API_KEY=your_payhero_api_key_here
PAYHERO_API_SECRET=your_payhero_api_secret_here
PAYHERO_CHANNEL_ID=your_channel_id_here
PAYHERO_BASE_URL=https://backend.payhero.co.ke/api/v2

# ------------------------------------------------------------------------------
# 2. Firebase Spark Plan Configuration (Free Tier $0.00 / Zero-SMS Cost)
# Client-side configuration uses public identifiers in js/features/firebase-config.js.
# Sensitive admin service credentials must remain server-side only.
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=shiftstack-aviator
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@shiftstack-aviator.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY=""
FIREBASE_SPARK_MODE=true

# ------------------------------------------------------------------------------
# 3. Game Math & Cryptography
# ------------------------------------------------------------------------------
MINIMUM_DEPOSIT_KES=49
MINIMUM_STAKE_KES=100
MAX_WEEKLY_PASSWORD_RESETS=2
